body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.job-card {
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.job-card h2 {
  font-size: 18px;
  margin-bottom: 10px;
}

.job-card p {
  font-size: 14px;
  margin-bottom: 20px;
}

.badge {
  background-color: #337ab7;
  color: #fff;
  padding: 5px 10px;
  border-radius: 5px;
  margin-right: 10px;
}

.dark-mode-toggle {
  position: fixed;
  top: 10px;
  right: 10px;
}

@media only screen and (max-width: 768px) {
  .container {
    padding: 10px;
  }
  .job-card {
    margin-bottom: 10px;
  }
}

.dark-mode {
  background-color: #333;
  color: #fff;
}

.dark-mode .job-card {
  background-color: #444;
  border-color: #555;
}

.dark-mode .badge {
  background-color: #666;
  color: #fff;
}