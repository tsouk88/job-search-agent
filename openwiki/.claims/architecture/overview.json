    {
      "id": "claim_b30db53241dd459ba0ea7e11572f6978",
      "statement": "Redis serves three distinct concerns in main.py: a per-query job cache (jobs:{query}:{country}, 14400s ex, read/set in searchhelper around fresh graph runs), rate-limit storage for slowapi (storage_uri=REDIS_URL with in-memory fallback), and a daily Gemini-call budget via check_gemini_budget which incr's gemini_calls:{name}:{date} with an 86400s expire and raises HTTP 429 past the limit (site=100, eval=5).",
      "evidence": [
