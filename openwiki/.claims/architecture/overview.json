    {
      "id": "claim_a7c74c9d054b480a93609fb308221613",
      "statement": "The search path is LLM-free: the graph fans out, collects, scores, ranks, and returns without any model call. Scoring in score_job is deterministic keyword arithmetic where a title hit outweighs any number of description hits, so >= TITLE_WEIGHT means matched in the title.",
      "evidence": [
        {
          "resource": "repo://agent.py#L203-L222",
          "version": "repo-lines-v1:sha256:03c56a9b89df58e70e4b7e78c5a2f3a66d58fabdacc5b7d180d17948ffb8c0cb:"
        },
