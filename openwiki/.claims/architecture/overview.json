    {
      "id": "claim_e027f490dd4349969bac4317cabd54a6",
      "statement": "REST compiles the graph twice: agent uses PostgresSaver with a 14400s (4h) freshness threshold on last_fetch_time, plus a Redis jobs:{query}:{country} cache (14400s ex) for cross-thread reuse; eval_agent uses InMemorySaver for /askeval. MCP uses an in-process _cache dict with CACHE_TTL=14400 and no checkpointer. Voice uses MemorySaver with per-session memory.",
      "evidence": [
