        }
      ]
    },
    {
      "id": "claim_90ad77046d7f4f1da4f039269b3428f4",
      "statement": "searchhelper re-runs the graph iff any of four conditions hold (no last_fetch_time, query changed, country changed, or over 14400s); country is part of the key because cached clean_jobs belong to the previously searched country. searched_country is input.country on a miss and the state's current_country on a hit, passed to format_jobs_markdown so the footer reports the country the displayed listings were actually searched under.",
      "evidence": [
        {
          "resource": "repo://main.py#L123-L151",
