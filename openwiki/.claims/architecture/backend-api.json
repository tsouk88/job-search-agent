    {
      "id": "claim_8f9264f386c7457b8a9e341e67c41cf9",
      "statement": "The /ask cache re-runs the agent iff any of four conditions hold: no stored last_fetch_time, the query changed (current_query != input.user_input), the country changed (current_country != input.country), or more than 14400s since the last fetch; country is part of the cache key because cached clean_jobs belong to the previously searched country.",
      "evidence": [
        {
          "resource": "repo://main.py#L65-L68",
          "version": "repo-lines-v1:sha256:33a98d41d6e4165647ab55b823d29bb034d16c7e6efcb8cc4d72844efaebbe74:"
        },
        {
