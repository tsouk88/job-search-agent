    {
      "id": "claim_5aaad6b2d2e041b085523b0cb6fac658",
      "statement": "distinctive_tokens() picks non-generic tokens in order, deduplicated and capped at TAG_LIMIT=3, for tag-based API queries; it returns the words that narrow the search and empty means the caller should ask without a tag.",
      "evidence": [
        {
          "resource": "repo://agent.py#L169-L182",
