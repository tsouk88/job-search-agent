        }
      ]
    },
    {
      "id": "claim_fd005fa4e4254a29b35c69d93884d9b2",
      "statement": "State now carries a country field (str, default '') in addition to user_input; fetched_jobs and memory both use the add_or_reset reducer, which appends or returns [] when new is None.",
