    {
      "id": "claim_7dab64df2b204ed89a74054414131407",
      "statement": "The workflow node chain is Schedule Trigger (every 12h) -> Search Settings (query + thread_id) -> Wake node (GET /docs, On Error: Continue, retryOnFail maxTries 2) -> Wait 120s -> Digest (POST /digest, httpHeaderAuth, 5 retries 5s apart, 90s timeout) -> If (links not empty) -> [true] Send a message (Gmail, message ={{ $json.md }}, executeOnce true) -> Mark Sent (POST /digest/sent, httpHeaderAuth).",
      "evidence": [
        {
          "resource": "repo://n8n_workflow.json#L209-L287",
          "version": "repo-lines-v1:sha256:5cd0db7fffda4bbf1dd0dfaabbf70fec1d01545c583afd470de3ee5b36dab04c:"
