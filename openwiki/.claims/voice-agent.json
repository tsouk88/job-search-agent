    {
      "id": "claim_f22e641b30ed40db98d6561d6841adea",
      "statement": "Each VoiceSession holds an in-memory memory list of exclusion keywords, a fresh uuid4 thread_id passed as the configurable LangGraph config, and a last_jobs cache of the last run's normalized results; run invokes the compiled graph and re-caches, while resume and reset only re-filter the cache locally without re-running the graph.",
      "evidence": [
        {
          "resource": "repo://voice_agent.py#L18-L50",
          "version": "repo-lines-v1:sha256:8478d21099a684d2c51756d873a140df47ca6df93a4981dc4e590004e4d20c8e:"
        }
      ]
    },
    {
      "id": "claim_b2155efc755a4178874e8f5a18a96b0e",
      "statement": "VoiceSession.resume runs a Gemini extraction prompt to pull avoidance keywords, appends them to memory, and re-filters the cached last_jobs locally via filter_jobs rather than re-invoking the graph or re-hitting the job APIs.",
