    {
      "id": "claim_0addb141d1a840e5befcac76590a788e",
      "statement": "title_hit uses regex r'\\b{token}(?:js|s|\\d+)?\\b' — whole word with optional suffix (plural, version digits, js) but no prefixes — replacing the earlier <4-char whole-word vs substring rule; rust does not match anti-trust, python matches python3, react matches reactjs.",
