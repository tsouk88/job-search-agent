    {
      "id": "claim_46911d440a6146fc8b640e0df48908d0",
      "statement": "score_job computes title_hits*TITLE_WEIGHT(10) plus a description contribution (desc_hits + generic-word title hits + freq/8) capped at 9, so description hits can only reorder listings that already earned a title hit and can never admit one; when the query is entirely generic words gen_hits is forced to 0. collect_results admits only jobs with score >= TITLE_WEIGHT, and additionally requires a title_hit on 'engineer' when the query wants it, so a generic 'engineer' query does not admit every listing.",
      "evidence": [
        {
          "resource": "repo://agent.py#L203-L222",
          "version": "repo-lines-v1:sha256:03c56a9b89df58e70e4b7e78c5a2f3a66d58fabdacc5b7d180d17948ffb8c0cb:"
