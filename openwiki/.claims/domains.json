    {
      "id": "claim_dae492a83172471ca20f305494466ea1",
      "statement": "canon() applies an ALIASES dict (large language models→llm, natural language processing→nlp, artificial intelligence→ai, machine learning→ml, full stack→fullstack, back-end→backend, postgresql→postgres, kubernetes→k8s, javascript→js, developer→engineer, etc.) so that synonym spellings match; without it 'ml engineer' and 'machine learning engineer' were disjoint result sets. It is applied to the query in signal_tokens/score_job/job_title, but distinctive_tokens deliberately operates on the raw lowercased query (tag APIs want the spelled-out word).",
      "evidence": [
        {
          "resource": "repo://agent.py#L135-L139",
          "version": "repo-lines-v1:sha256:d05474b59197fea27ebddbbed5a9534fea16bb9b42d7f655a86db04ef3ff590f:"
