    {
      "id": "claim_0391a247f6e84f1fb3d5f869c427fb84",
      "statement": "The Harbor eval freezes six job sources: RemoteOK, Himalayas, Remotive, Jobicy (JSON APIs mapped by hostname in HOSTS), Workable (HTML at jobs.workable.com), and Getro (API at api.getro.com). The environment enforces this by raising RuntimeError for any unfrozen host, ensuring that adding a seventh source to the agent's fan-out graph would cause the eval to fail.",
      "evidence": [
        {
          "resource": "repo://agent.py#L614-L621",
          "version": "repo-lines-v1:sha256:24a93db40fdffa3661972cd95b15f8f850203a02ff833ab8f28acf67e1837733:"
