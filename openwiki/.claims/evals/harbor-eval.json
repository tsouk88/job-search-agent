    {
      "id": "claim_9c3139f9a7774d9292888c7c9e3c0257",
      "statement": "frozen_apis.py replaces requests.get with frozen_get and requests.post with frozen_post, while replacing other requests entry points (put, patch, delete, head, options, request) and Session.request with a blocked function that raises RuntimeError, so unhandled network calls fail in-process even on a networked host.",
