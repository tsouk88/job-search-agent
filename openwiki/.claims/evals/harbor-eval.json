    {
      "id": "claim_9c3139f9a7774d9292888c7c9e3c0257",
      "statement": "frozen_apis.py enforces strict network isolation by replacing requests.get and requests.post with routing functions and overriding all other requests entry points (put, patch, delete, head, options, request) and Session.request with a blocked function that raises RuntimeError, guaranteeing that even on a networked host, the eval cannot make live network calls.",
      "evidence": [
        {
          "resource": "repo://evals/filter-exclusion-senior/environment/frozen_apis.py#L82-L86",
          "version": "repo-lines-v1:sha256:165097d9c8c28bfcfb2584416335fa5602944e1c5c813540e83f79d44fec7066:"
        }
      ]
    },
    {
      "id": "claim_76a0cb7f1a754496bf67b28dca3c3f5d",
      "statement": "Network isolation is enforced by a Docker Compose overlay (evals/configs/no-network.yaml sets network_mode: none on the main service) passed via --extra-docker-compose, while task.toml declares network_mode = 'public' because Harbor's no-network policy is unavailable on WSL2 hosts; the overlay is the enforcement, not the declaration.",
      "evidence": [
        {
          "resource": "repo://evals/configs/no-network.yaml",
