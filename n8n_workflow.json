        "jsCode": "const positionKeywords = [\"python\", \"ai\", \"machine learning\", \"backend\", \"fastapi\", \"engineer\", \"backend developer\", \"automation\", \"llm\", \"rag\", \"langchain\"];\nconst acceptableLevels = [\"Any\", \"Entry\", \"Junior\", \"Midweight\"];\n\nconst filtered = items.filter(item => {\n  const pos = (item.json.jobTitle || \"\").toLowerCase();\n  const posMatch = positionKeywords.some(pk => \n    new RegExp(`\\\\b${pk}\\\\b`, 'i').test(pos)\n  );\n  const levelMatch = acceptableLevels.includes(item.json.jobLevel);\n  return posMatch && levelMatch;\n});\n\nconst jobicyEmailBody = filtered.map(item => \n  `${item.json.jobTitle} - ${item.json.companyName}\\n${item.json.url}\\n${item.json.jobDescription}`\n).join(\"\\n\\n\");\n\nreturn [{ json: { emailBody: \"=== JOBICY JOBS ===\\n\\n\" + jobicyEmailBody } }];"
