        "jsCode": "const positionKeywords = [\"python\", \"ai\", \"machine learning\", \"backend\", \"fastapi\", \"engineer\", \"backend developer\", \"automation\", \"llm\", \"rag\", \"langchain\"];\nconst acceptableSeniority = [\"Entry-level\", \"Mid-level\"];\n\nconst HimalayasJobs = items[0].json.jobs || [];\nconst filteredjobs = HimalayasJobs.filter(item => {\n  const pos = (item.title || \"\").toLowerCase();\n\n  const posMatch = positionKeywords.some(pk => \n    new RegExp(`\\\\b${pk}\\\\b`, 'i').test(pos)\n  );\n  const seniorityMatch = (item.seniority || []).some(s => acceptableSeniority.includes(s));\n\n  return posMatch && seniorityMatch;\n});\n\nconst email = filteredjobs.map(item => \n  `${item.title} - ${item.companyName}\\n${item.applicationLink}\\n${item.excerpt}`\n).join(\"\\n\\n\");\n\nreturn [{ json: { emailBody: \"=== Himalayas JOBS ===\\n\\n\" + email } }];"
