    {
      "parameters": {
        "jsCode": "const positionKeywords = [\"python\", \"ai\", \"machine learning\", \"backend\", \"fastapi\", \"engineer\", \"backend developer\", \"automation\", \"llm\", \"rag\", \"langchain\"];\nconst excludeKeywords = [\"senior\", \"staff\", \"lead\", \"principal\", \"head of\", \"director\"];\n\nconst remotiveJobs = items[0].json.jobs || [];\nconst filteredjobs = remotiveJobs.filter(item => {\n  const pos = (item.title || \"\").toLowerCase();\n  const location = (item.candidate_required_location || \"\").toLowerCase();\n\n  const posMatch = positionKeywords.some(pk => \n    new RegExp(`\\\\b${pk}\\\\b`, 'i').test(pos)\n  );\n  const locationMatch = location.includes(\"worldwide\") || \n                        location.includes(\"europe\") || \n                        location.includes(\"anywhere\");\n  const isExcluded = excludeKeywords.some(ek => pos.includes(ek));\n\n  return posMatch && locationMatch && !isExcluded;\n});\n\nconst email = filteredjobs.map(item => \n  `${item.title} - ${item.company_name}\\n${item.url}\\n${item.description}`\n).join(\"\\n\\n\");\n\nreturn [{ json: { emailBody: \"=== REMOTIVE JOBS ===\\n\\n\" + email } }];"
      },
