      "parameters": {
        "jsCode": "const positionKeywords = [\"python\", \"ai\", \"machine learning\", \"backend\", \"fastapi\", \"engineer\", \"backend developer\", \"automation\", \"llm\", \"rag\", \"langchain\"];\nconst excludeKeywords = [\"senior\", \"staff\", \"lead\", \"principal\", \"head of\", \"director\"];\n\nconst filtered = items.filter(item => {\n  const pos = (item.json.position || \"\").toLowerCase();\n\n  const posMatch = positionKeywords.some(pk => \n    new RegExp(`\\\\b${pk}\\\\b`, 'i').test(pos)\n  );\n  const isExcluded = excludeKeywords.some(ek => pos.includes(ek));\n\n  return posMatch && !isExcluded;\n});\n\nconst remoteokEmailBody = filtered.map(item => \n  `${item.json.position} - ${item.json.company}\\n${item.json.url}\\n${item.json.description}`\n).join(\"\\n\\n\");\n\nreturn [{ json: { emailBody: \"=== REMOTEOK JOBS ===\\n\\n\" + remoteokEmailBody } }];"
      },
